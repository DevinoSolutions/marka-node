{
  "name": "@joinmarka/sdk",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "build:dist": "tsup && node scripts/postbuild-dts.mjs",
    "size": "size-limit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "size-limit": [
    {
      "name": "published dist JS (brotlied) — this is what npm consumers download and parse",
      "path": [
        "dist/**/*.js",
        "!dist/**/*.map"
      ],
      "limit": "25 KB"
    }
  ],
  "dependencies": {
    "@marka/shared": "workspace:*",
    "@mastra/core": "1.68.0",
    "@mastra/mcp": "1.18.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@size-limit/file": "13.0.3",
    "size-limit": "13.0.3",
    "tsup": "8.5.0",
    "typescript": "6.0.2"
  },
  "bin": {
    "marka-mcp-stdio": "./bin/mcp-stdio.mjs"
  }
}
